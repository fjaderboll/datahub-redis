version: "3.9"

services:
  redis:
    image: redis:8.10.2
    volumes:
      - "redis-data:/data"
    command: redis-server --save "86400 1 21600 20000"
  emqx:
    image: emqx:5.5.0
    volumes:
      - "./cluster.hocon:/opt/emqx/data/configs/cluster.hocon"
    ports:
      - "1883:1883"
      - "18083:18083"
    environment:
      - "EMQX_dashboard__default_username=admin"
      - "EMQX_dashboard__default_password=admin123"
    #healthcheck:
    #  test: ["CMD", "/opt/emqx/bin/emqx", "ctl", "status"]
    #  interval: 30s
    #  timeout: 25s
    #  retries: 5
  app:
    image: datahub-app
    environment:
      - "REDIS_HOST=redis"
      - "REDIS_PORT=6379"
      - "MQTT_BROKER_URL=emqx"
      - "MQTT_BROKER_PORT=1883"
      - "MQTT_USERNAME=mqtt"
      - "MQTT_PASSWORD=mqtt123"
    volumes:
      - "app-data:/data"
  web:
    image: datahub-web
    ports:
      - "8080:80"
volumes:
  redis-data:
  app-data:
