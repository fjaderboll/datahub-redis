#!/command/with-contenv sh
# Readings are kept in memory and saved to /data/redis/dump.rdb once a day
# (every 6 hours with many changes) and when the container is stopped.
exec s6-notifyoncheck -d -n 0 -w 200 \
	s6-setuidgid datahub \
	redis-server \
		--bind 127.0.0.1 -::1 \
		--dir /data/redis \
		--save "86400 1 21600 20000" \
		--loadmodule /usr/local/lib/redis/modules/redistimeseries.so
