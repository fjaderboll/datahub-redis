#!/command/with-contenv sh
# a pid file left from before a container restart can make NanoMQ believe it is already running
rm -f /tmp/nanomq/nanomq.pid

# Each message waiting for a topic permission check blocks a task thread until the app has answered, and
# receiving the answer needs another free task thread. With as many workers (parallel) as task threads, a burst
# of messages blocks all of them and every check times out. NanoMQ ignores the thread settings in its config and
# always uses 2 per CPU, at most 16, so leave two of them free: one for a login check, one to complete the requests.
threads=$(( $(getconf _NPROCESSORS_ONLN) * 2 ))
[ $threads -gt 16 ] && threads=16
parallel=$(( threads - 2 ))
[ $parallel -lt 1 ] && parallel=1

exec s6-notifyoncheck -d -n 0 -w 200 \
	s6-setuidgid datahub \
	nanomq start --conf /etc/nanomq.conf --parallel $parallel
